{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `../static/parts/**` reaches OUTSIDE the package on purpose. A system's
      // token package assembles the report-kit bundles from the hand-authored
      // parts one directory over, so those files decide the contents of
      // static/thl.css while living outside everything $TURBO_DEFAULT$ hashes.
      //
      // Measured, not assumed: with the cache warm, appending a rule to
      // static/parts/components.css and re-running gave "1 cached, FULL TURBO"
      // and replayed the generator's own "4 bundles in static/" line, while
      // thl.css still held the previous contents. That stale bundle is what
      // sync-static copies to public/ and what `shadcn build` embeds in the
      // published report-kit item — and no gate sees it, because smoke's byte
      // check compares the registry against the same stale file on disk.
      //
      // Written generically rather than as an @<ns>/tokens# override so a second
      // system is covered the day it exists. It matches nothing under apps/docs,
      // which is the correct answer there.
      //
      // `../CHANGELOG.md` is here for exactly the same reason, and it is the
      // sharper edge of the two. It is the ONLY place a system's version is
      // declared, and the generator stamps that version into version.generated.ts
      // and every report-kit bundle header. Undeclared, bumping the version
      // changes no file turbo hashes: the task reports FULL TURBO, replays the
      // old log line, and every artifact keeps claiming the previous version —
      // including the one that ships to a consumer's disk. `check-version` would
      // then fail the build, which is the good outcome, but only because the gate
      // exists; the cache key is what makes the regenerate happen at all.
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../static/parts/**", "../CHANGELOG.md"],
      // NEXT_PUBLIC_SITE_URL must be in the cache key. It is the one place the
      // published location is declared, and basePath, metadataBase and the
      // registry homepage are all derived from it — so it changes the CONTENTS of
      // out/, not just how it is served. Undeclared, turbo hashes two different
      // sites to the same key and replays whichever built first: a local
      // no-basePath build restores over a subpath build, every asset URL loses
      // its prefix, and the task still reports success.
      //
      // Measured, not assumed: `turbo build` after `rm -rf out/` returned "cache
      // hit, replaying logs" and produced an icon href of
      // /systems/human-laboratory/icon.svg where the same source built with
      // --force gives /imprint_lab/systems/human-laboratory/icon.svg. Harmless in
      // CI today because the cache starts cold, and a live publishing bug the day
      // remote caching is switched on.
      "env": ["NEXT_PUBLIC_SITE_URL"],
      // The last two also reach outside the package, and for the same reason:
      // token-tools writes six artifacts a system's token package does not
      // contain — the four static/thl.* bundles, and the two *.generated.ts
      // files that land beside cn() so a registry consumer receives them as
      // plain files. Undeclared, a cache hit restores generated/ and leaves
      // those six untouched: deleting all six and re-running gave FULL TURBO
      // with the files still missing and the task reporting success.
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "out/**",
        "generated/**",
        "public/r/**",
        "../static/thl.*",
        "../ui/lib/*.generated.ts"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      // `../CHANGELOG.md` is here for the same reason it is on `build`, and it
      // matters more here: `check-version` runs under this task, and its whole
      // job is catching a changelog that was edited without a regenerate. The
      // file is the ONLY declaration of a system's version and it lives one
      // directory above the token package, so nothing in $TURBO_DEFAULT$ hashes
      // it — which made the staleness gate able to replay a stale pass.
      //
      // Measured, not assumed. Cutting v1.1.0 is what surfaced it: with the
      // cache warm, appending a line to systems/human-laboratory/CHANGELOG.md
      // and re-running gave `@thl/tokens:lint: cache hit, replaying logs` and
      // `>>> FULL TURBO`, and check-version printed `v1.0.0 — consistent` after
      // the bump — correct artifacts, stale output. With it declared, the same
      // edit gives `cache miss, executing`.
      //
      // Only this one input is needed, which was also measured rather than
      // guessed. `@thl/ui`'s lint runs `check-roles ..`, which reads
      // ../tokens/theme.css from outside its own package — but editing that file
      // already misses, because it lives inside @thl/tokens and `^lint` cascades
      // the miss downstream. Declaring it here too would have been cargo cult.
      //
      // Written generically rather than as an @<ns>/tokens# override so a second
      // system is covered the day it exists. It matches nothing under apps/docs
      // or packages/*, which is the correct answer there.
      "inputs": ["$TURBO_DEFAULT$", "../CHANGELOG.md"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
