{
  "name": "imprint_lab",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "check": "biome check .",
    "check-types": "turbo run check-types",
    "new-system": "bun run --cwd packages/system-template new-system.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "turbo": "^2.7.6",
    "typescript": "5.9.2",
    "@imprint/system-template": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.17",
  "workspaces": [
    "apps/*",
    "packages/*",
    "systems/*/*"
  ]
}
