# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for commiting if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Registry JSON is generated from systems/*/registry.json at build time.
public/r/

# Report kit bundles are staged from systems/*/static at build time.
public/*.css
public/*-catalog.html
public/report.html

# Brand assets are staged from systems/*/brand at build time.
public/brand/

# The route-segment favicon, written by scripts/sync-static.mjs from that
# system's brand/favicon.svg. Next resolves app/<segment>/icon.svg by file
# convention, so unlike everything else here the generated file has to live
# inside app/ — a symlink fails the build with "Cannot find module for page".
# It is no more hand-authored for sitting there.
app/systems/*/icon.svg
