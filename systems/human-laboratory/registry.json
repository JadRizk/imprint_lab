{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "thl",
  "homepage": "https://jadrizk.github.io/imprint_lab",
  "items": [
    {
      "name": "style",
      "type": "registry:style",
      "extends": "none",
      "title": "The Human Laboratory",
      "description": "The base style. Tokens, base layer and cn(). Install this before any component \u2014 it is what the components' class names resolve against.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "systems/human-laboratory/tokens/theme.css",
          "type": "registry:file",
          "target": "~/thl/styles/theme.css"
        },
        {
          "path": "systems/human-laboratory/tokens/base.css",
          "type": "registry:file",
          "target": "~/thl/styles/base.css"
        },
        {
          "path": "systems/human-laboratory/ui/lib/utils.ts",
          "type": "registry:file",
          "target": "~/thl/lib/utils.ts"
        },
        {
          "path": "systems/human-laboratory/ui/lib/tw-merge.generated.ts",
          "type": "registry:file",
          "target": "~/thl/lib/tw-merge.generated.ts"
        },
        {
          "path": "systems/human-laboratory/ui/lib/motion.generated.ts",
          "type": "registry:file",
          "target": "~/thl/lib/motion.generated.ts"
        },
        {
          "path": "systems/human-laboratory/ui/lib/version.generated.ts",
          "type": "registry:file",
          "target": "~/thl/lib/version.generated.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "Variant-based button. Four variants, four sizes, Radix Slot for polymorphism.",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority"],
      "registryDependencies": ["style"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/button.tsx",
          "type": "registry:file",
          "target": "~/thl/components/button.tsx"
        }
      ]
    },
    {
      "name": "page-shell",
      "type": "registry:component",
      "title": "PageShell",
      "description": "Owns the horizontal gutter and page measure. Use instead of Tailwind's container, whose width varies by breakpoint. Never nest it.",
      "registryDependencies": ["style"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/page-shell.tsx",
          "type": "registry:file",
          "target": "~/thl/components/page-shell.tsx"
        }
      ]
    },
    {
      "name": "section-header",
      "type": "registry:component",
      "title": "SectionHeader",
      "description": "The lime-square eyebrow. Use rather than rebuilding the square-plus-label pattern.",
      "registryDependencies": ["style"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/section-header.tsx",
          "type": "registry:file",
          "target": "~/thl/components/section-header.tsx"
        }
      ]
    },
    {
      "name": "bento-grid",
      "type": "registry:component",
      "title": "BentoGrid",
      "description": "Grid primitive that orchestrates BentoCard entrance staggering via context. Reduced-motion aware.",
      "dependencies": ["framer-motion"],
      "registryDependencies": ["style"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/bento-grid.tsx",
          "type": "registry:file",
          "target": "~/thl/components/bento-grid.tsx"
        }
      ]
    },
    {
      "name": "bento-card",
      "type": "registry:component",
      "title": "BentoCard",
      "description": "Animated card surface with corner brackets. Defers to a parent BentoGrid's stagger when inside one, self-triggers when standalone.",
      "dependencies": ["framer-motion"],
      "registryDependencies": ["style", "bento-grid"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/bento-card.tsx",
          "type": "registry:file",
          "target": "~/thl/components/bento-card.tsx"
        }
      ]
    },
    {
      "name": "image-frame",
      "type": "registry:component",
      "title": "ImageFrame",
      "description": "Animated image reveal with grid overlay, scan line, corner markers and a SIGNAL_LOST error state. Ships its own CSS module.",
      "dependencies": ["framer-motion"],
      "registryDependencies": ["style"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/image-frame.tsx",
          "type": "registry:file",
          "target": "~/thl/components/image-frame.tsx"
        },
        {
          "path": "systems/human-laboratory/ui/components/image-frame.module.css",
          "type": "registry:file",
          "target": "~/thl/components/image-frame.module.css"
        }
      ]
    },
    {
      "name": "mark",
      "type": "registry:component",
      "title": "Mark",
      "description": "The Human Laboratory mark: a bounded frame with one corner promoted a tier. Roles only, so it reskins under another system. Accent and mono tones.",
      "registryDependencies": ["style"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/mark.tsx",
          "type": "registry:file",
          "target": "~/thl/components/mark.tsx"
        }
      ]
    },
    {
      "name": "wordmark",
      "type": "registry:component",
      "title": "Wordmark",
      "description": "The lockup: mark plus name, horizontal or stacked. The wordmark is type rather than an SVG, because this system names no font.",
      "registryDependencies": ["style", "mark"],
      "files": [
        {
          "path": "systems/human-laboratory/ui/components/wordmark.tsx",
          "type": "registry:file",
          "target": "~/thl/components/wordmark.tsx"
        }
      ]
    },
    {
      "name": "brand",
      "type": "registry:file",
      "title": "Brand assets",
      "description": "Mark, monochrome mark, favicon and the rules that govern them — the vector sources only, since a registry file travels as UTF-8 text; run brand:raster for the PNGs. The brand belongs to the system, not to imprint_lab — adopting @thl means adopting its identity.",
      "files": [
        {
          "path": "systems/human-laboratory/brand/mark.svg",
          "type": "registry:file",
          "target": "~/thl/brand/mark.svg"
        },
        {
          "path": "systems/human-laboratory/brand/mark-mono.svg",
          "type": "registry:file",
          "target": "~/thl/brand/mark-mono.svg"
        },
        {
          "path": "systems/human-laboratory/brand/favicon.svg",
          "type": "registry:file",
          "target": "~/thl/brand/favicon.svg"
        },
        {
          "path": "systems/human-laboratory/brand/README.md",
          "type": "registry:file",
          "target": "~/thl/brand/README.md"
        }
      ]
    },
    {
      "name": "report-kit",
      "type": "registry:file",
      "title": "THL report kit",
      "description": "Pure HTML/CSS tier for standalone reports, audits and documents. Tokens, reset and ~20 primitives, plus opt-in chart, diagram and interaction layers, a worked example, and the agent instructions for composing them.",
      "files": [
        {
          "path": "systems/human-laboratory/static/thl.css",
          "type": "registry:file",
          "target": "~/thl/thl.css"
        },
        {
          "path": "systems/human-laboratory/static/thl.chart.css",
          "type": "registry:file",
          "target": "~/thl/thl.chart.css"
        },
        {
          "path": "systems/human-laboratory/static/thl.fonts.css",
          "type": "registry:file",
          "target": "~/thl/thl.fonts.css"
        },
        {
          "path": "systems/human-laboratory/static/report.html",
          "type": "registry:file",
          "target": "~/thl/report.html"
        },
        {
          "path": "systems/human-laboratory/static/SKILL.md",
          "type": "registry:file",
          "target": "~/thl/SKILL.md"
        },
        {
          "path": "systems/human-laboratory/static/thl.diagram.css",
          "type": "registry:file",
          "target": "~/thl/thl.diagram.css"
        },
        {
          "path": "systems/human-laboratory/static/thl.interact.js",
          "type": "registry:file",
          "target": "~/thl/thl.interact.js"
        },
        {
          "path": "systems/human-laboratory/static/example-report.html",
          "type": "registry:file",
          "target": "~/thl/example-report.html"
        }
      ]
    }
  ]
}
