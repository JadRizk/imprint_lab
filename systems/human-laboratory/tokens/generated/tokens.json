    "lime": {
      "$value": "#DFFF00"
    },
    "slate": {
      "$value": "#242424",
      "$description": "1.23:1 — the quietest drawn line"
    },
    "steel": {
      "$value": "#3A3A3A",
      "$description": "1.69:1 — the default drawn line"
    },
    "graphite": {
      "$value": "#585858",
      "$description": "2.69:1 — the loud drawn line"
    },
    "white": {
      "$value": "#FFFFFF"
    },
    "black": {
      "$value": "#000000"
    },
    "text-secondary": {
      "$value": "#A3A3A3",
      "$description": "7.60:1 — body copy (the body default)"
    },
    "text-tertiary": {
      "$value": "#7C7C7C",
      "$description": "4.59:1 — labels, metadata, tags"
