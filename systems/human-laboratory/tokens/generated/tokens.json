{
  "$description": "Design tokens for human-laboratory. Generated from theme.css. Values are W3C DTCG; where CSS has no DTCG equivalent the original declaration is kept under $extensions[\"com.imprintlab\"].css.",
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    }
