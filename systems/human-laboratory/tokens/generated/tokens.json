{
  "$description": "Design tokens for human-laboratory. Generated from theme.css. Values are W3C DTCG; where CSS has no DTCG equivalent the original declaration is kept under $extensions[\"com.imprintlab\"].css.",
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    }
  },
  "color": {
    "$type": "color",
    "obsidian": {
      "$value": "#0F0F0F"
    },
    "lime": {
      "$value": "#DFFF00"
    },
    "steel": {
      "$value": "#333333"
    },
    "white": {
      "$value": "#FFFFFF"
    },
    "black": {
      "$value": "#000000"
    },
    "surface": {
      "$value": "#0A0A0A"
    },
    "text-secondary": {
      "$value": "#A3A3A3",
      "$description": "7.62:1 — body copy (the body default)"
    },
    "text-tertiary": {
      "$value": "#7C7C7C",
      "$description": "4.59:1 — labels, metadata, tags"
    },
    "ambient": {
      "$value": "#3A3A3A"
    },
    "canvas": {
      "$value": "{color.obsidian}"
    },
    "line": {
      "$value": "{color.steel}"
    },
    "ink": {
      "$value": "{color.white}"
    },
    "ink-muted": {
      "$value": "{color.text-secondary}"
    },
    "ink-subtle": {
      "$value": "{color.text-tertiary}"
    },
    "accent": {
      "$value": "{color.lime}"
    },
    "accent-ink": {
      "$value": "{color.black}"
    },
    "critical": {
      "$value": "#FF4A4A",
      "$description": "5.78:1 — errors, destructive actions"
    },
    "warning": {
      "$value": "#FF8A00",
      "$description": "8.11:1 — warnings, degraded states"
    }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "sans-serif"
      ],
      "$extensions": {
        "com.imprintlab": {
          "css": "var(--font-sans-face, sans-serif)"
        }
      }
    },
    "mono": {
      "$value": [
        "monospace"
      ],
      "$extensions": {
        "com.imprintlab": {
          "css": "var(--font-mono-face, monospace)"
        }
      }
    }
  },
  "fontSize": {
    "$type": "dimension",
    "micro": {
      "$value": {
        "value": 0.625,
        "unit": "rem"
      }
    },
    "xs": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "sm": {
      "$value": {
        "value": 0.875,
        "unit": "rem"
      }
    },
    "base": {
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "lg": {
      "$value": {
        "value": 1.125,
        "unit": "rem"
      }
    },
    "xl": {
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "2xl": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "3xl": {
      "$value": {
        "value": 1.875,
        "unit": "rem"
      }
    },
    "4xl": {
      "$value": {
        "value": 2.25,
        "unit": "rem"
      }
    },
    "5xl": {
      "$value": {
        "value": 3,
        "unit": "rem"
      }
    },
    "6xl": {
      "$value": {
        "value": 3.75,
        "unit": "rem"
      }
    }
  },
  "lineHeight": {
    "micro": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "xs": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 1.25,
        "unit": "rem"
      }
    },
    "base": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "xl": {
      "$type": "dimension",
      "$value": {
        "value": 1.75,
        "unit": "rem"
      }
    },
    "2xl": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    },
    "3xl": {
      "$type": "dimension",
      "$value": {
        "value": 2.25,
        "unit": "rem"
      }
    },
    "4xl": {
      "$type": "dimension",
      "$value": {
        "value": 2.5,
        "unit": "rem"
      }
    },
    "5xl": {
      "$type": "number",
      "$value": 1
    },
    "6xl": {
      "$type": "number",
      "$value": 1
    }
  },
  "letterSpacing": {
    "$type": "number",
    "label": {
      "$value": 0.2,
      "$extensions": {
        "com.imprintlab": {
          "css": "0.2em"
        }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "lime-glow": {
      "$value": {
        "color": "rgba(223, 255, 0, 0.3)",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 0,
          "unit": "px"
        },
        "blur": {
          "value": 15,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      },
      "$extensions": {
        "com.imprintlab": {
          "css": "0 0 15px rgba(223, 255, 0, 0.3)"
        }
      }
    },
    "lime-glow-lg": {
      "$value": [
        {
          "color": "rgba(223, 255, 0, 0.4)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 30,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": "rgba(223, 255, 0, 0.1)",
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 60,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      ],
      "$extensions": {
        "com.imprintlab": {
          "css": "0 0 30px rgba(223, 255, 0, 0.4), 0 0 60px rgba(223, 255, 0, 0.1)"
        }
      }
    },
    "glow": {
      "$value": "{shadow.lime-glow}"
    }
  },
  "animation": {
    "$type": "duration",
    "scan": {
      "$value": {
        "value": 4,
        "unit": "s"
      },
      "$extensions": {
        "com.imprintlab": {
          "css": "scan 4s linear infinite",
          "timingFunction": [
            0,
            0,
            1,
            1
          ]
        }
      }
    }
  }
}
